DATABASE_URL=postgresql://user:password@localhost:5432/basgiath
PORT=5000
NODE_ENV=production

# Auth configuration
# bcrypt cost factor for password hashing (higher = slower but more secure; default: 10)
AUTH_BCRYPT_ROUNDS=10
# Number of days a session token remains valid (default: 7)
AUTH_SESSION_EXPIRY_DAYS=7

# Keep existing Basgiath logins and automatically translate each reader's data on first open.
# DATABASE_URL remains the original account/source database; ROWAN_DATABASE_URL holds Rowan data.
# Migrate the Rowan target before enabling this mode. Existing standalone installs can leave false.
ROWAN_EXISTING_ACCOUNTS=false
